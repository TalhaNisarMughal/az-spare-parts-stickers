# ============================================================
# AZ Spare Parts and Stickers — Backend environment
# ============================================================

# Neon PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# JWT signing key (random — regenerate any time; users just re-login)
# generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Seeded login accounts (role: admin sees Dashboard + everything; user sees everything except Dashboard)
# SECRET_KEY and both passwords are required — the app will not start until you set real ones.
ADMIN_EMAIL=admin@azspareparts.com
ADMIN_PASSWORD=CHANGE_ME
ADMIN_NAME=Administrator
USER_EMAIL=user@azspareparts.com
USER_PASSWORD=CHANGE_ME
USER_NAME=Staff User

# Folder (inside backend/) where generated bill slip PDFs are saved
BILLS_DIR=generated_bills

# Frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
